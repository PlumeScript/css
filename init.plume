// Sanitize css
macro escapeCSS(String s)
	$s.replace(;, \\3B\s).replace({, \\7B\s).replace(}, \\7D\s)
end

// Convert name to html format
macro convertName(String s)
	$s.replace(([A-Z]), -%1, ?rich).lower()
end

// Handle custom types
macro getType(x)
	if type(x) == "table"
		$(x.type? or "table")
	else
		$type($x)
	end
end

// New set of CSS rules
// @param ...props table
//		* Notes on props:
//			*	Values with numerics keys will be inserted as nested rules
//			*	Values with string keys will be insterted as css property.
//			*	Property names will be converted from `myCustomProperty` to `my-custom-property`
macro css(...props)
	for name, value in items(props)
		if getType(value) == "cssVar"
			set value = var($value)
		end

		if type(name) == "number"
			$value
		else
			$escapeCSS($convertName($name))\: $escapeCSS($value);
		end
	end
end

// New set of CSS rules with a selector
// @param selector string
// @param ...props table (see css macro)
macro Rule(selector, ...props)
	...props
	meta tostring: macro()
		$selector {$css(...self)}
	end
end

// New CSS variable
macro var(name)
	type: cssVar
	meta tostring: macro()
		--$name
	end
end

Rule: $Rule
css: $css
var: $var


macro isUnit(x)
	$ (type(x) == "table" and x.type? == "cssunit")
end

ref unit: macro(value, unitname, ?calc)
	type: cssunit
	value: $value
	unit: $unitname
	calc: $calc

	meta add: macro(x, y)
		if not isUnit(x) or not isUnit(y)
			raise Cannot add "number" and "unit"
		end

		if x.unit == y.unit and type(x.value) == "number" and type(y.value) == "number"
			return $ unit(x.value + y.value, x.unit)
		else
			return $unit($x.get() + $y.get(),,?calc)
		end
	end

	meta sub: macro(x, y)
		if not isUnit(x) or not isUnit(y)
			raise Cannot sub "number" and "unit"
		end

		if x.unit == y.unit and type(x.value) == "number" and type(y.value) == "number"
			return $ unit(x.value - y.value, x.unit)
		else
			return $unit($x.get() - ($y.get()),,?calc)
		end
	end

	meta mul: macro(x, y)
		if not isUnit(x)
			if type(x) == "number" or x.isNumber()
				return $ unit(x, self.unit) * y
			else
				raise Unsuported type "$type($x)"
			end
		end
		if not isUnit(y)
			if type(y) == "number" or y.isNumber()
				return $ x * unit(y, self.unit)
			else
				raise Unsuported type "$type($y)"
			end
		end

		if x.unit == y.unit and type(x.value) == "number" and type(y.value) == "number"
			return $ unit(x.value * y.value, x.unit)
		else
			return $unit(($x.get()) * ($y.get()),,?calc)
		end
	end

	meta div: macro(x, y)
		if not isUnit(x)
			if type(x) == "number" or x.isNumber()
				return $ unit(x, self.unit) / y
			else
				raise Unsuported type "$type($x)"
			end
		end
		if not isUnit(y)
			raise Cannot divide a "number" by an "unit".
		end

		if x.unit == y.unit and type(x.value) == "number" and type(y.value) == "number"
			return $ unit(x.value / y.value, x.unit)
		else
			return $unit(($x.get()) / ($y.get()),,?calc)
		end
	end

	meta tostring: macro()
		if calc
			calc($self.value)
		else
			$self.value$self.unit
		end
	end
	get: macro()
		$self.value$self.unit
	end
end